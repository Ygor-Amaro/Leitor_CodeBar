# Copie para `.env` e ajuste o que precisar. Sem o arquivo, valem estes mesmos
# padrões. Argumentos da linha de comando têm precedência sobre o `.env`.

# ─── Leitura ──────────────────────────────────────────────────────────────────

# Pasta (ou arquivo PDF) de onde os documentos são lidos.
LEITOR_CB_ENTRADA=data/input

# Pasta onde o relatório CSV é gravado.
LEITOR_CB_SAIDA=data/output

# Zooms de renderização tentados em ordem. Zoom maior lê digitalização ruim, mas
# custa tempo e memória; a escalada para no primeiro que achar algo aproveitável.
LEITOR_CB_ZOOMS=2.0,3.0

# Formatos procurados na página. ITF é o código da ficha de compensação, Code128
# aparece em emissores que imprimem os mesmos 44 dígitos nesse formato, e QRCode
# é o PIX. Restringir acelera a varredura e evita ler ruído — mas tirar um
# formato daqui faz o boleto correspondente virar "nenhum código encontrado".
LEITOR_CB_FORMATOS=ITF,Code128,QRCode

# ─── Servidor web ─────────────────────────────────────────────────────────────

# 127.0.0.1 só atende a própria máquina. Dentro de contêiner precisa ser 0.0.0.0
# (o Dockerfile já define), e aí quem controla a exposição é a porta publicada.
LEITOR_CB_HOST=127.0.0.1
LEITOR_CB_PORTA=8000

# Raiz dos dados: banco do histórico, uploads e saída ficam abaixo dela.
LEITOR_CB_DADOS=data

# Triagem dos envios.
LEITOR_CB_TAMANHO_MAXIMO_MB=25
LEITOR_CB_MAXIMO_ARQUIVOS=50

# Por quanto tempo os PDFs enviados ficam em disco. Não é zero porque o recorte
# manual precisa do arquivo original.
LEITOR_CB_RETENCAO_HORAS=24
